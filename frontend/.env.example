# ============================================================
# INCIDENT ROOM — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# Backend API base URL (FastAPI)
REACT_APP_API_URL=http://localhost:8000

# WebSocket URL (FastAPI WebSocket)
REACT_APP_WS_URL=ws://localhost:8000/ws

# Optional: Anthropic API key for direct browser AI calls
# If left blank, the app falls back to rule-based AI responses.
# NOTE: Only set this for local dev. Never expose a real key in production.
REACT_APP_ANTHROPIC_KEY=
